{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SectrC: Debug (custom args)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/sectrc_debug",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build SectrC (debug)",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "SectrC: Debug --help",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/sectrc_debug",
            "args": ["--help"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build SectrC (debug)"
        },
        {
            "name": "SectrC: Debug --version",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/sectrc_debug",
            "args": ["--version"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build SectrC (debug)"
        },
        {
            "name": "SectrC: Debug --list",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/sectrc_debug",
            "args": ["--list"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build SectrC (debug)"
        },
        {
            "name": "SectrC: Debug --view-logs",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/sectrc_debug",
            "args": ["--view-logs"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build SectrC (debug)"
        },
        {
            "name": "SectrC: Debug --no-color --list",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/sectrc_debug",
            "args": ["--no-color", "--list"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build SectrC (debug)"
        },
        {
            "name": "SectrC: Debug --fingerprint (prompt for device)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/sectrc_debug",
            "args": ["--fingerprint", "${input:sectrcDevicePath}"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build SectrC (debug)"
        }
    ],
    "inputs": [
        {
            "id": "sectrcDevicePath",
            "type": "promptString",
            "description": "Disk device path to fingerprint",
            "default": "/dev/sda"
        }
    ]
}